# AegisVision 基础设施与平台环境变量模板
# 使用前请复制为 .env 并按实际环境修改密钥与内网 IP

TZ=Asia/Shanghai

# PostgreSQL 16
POSTGRES_DB=aegisvision
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_dev_change_me
POSTGRES_PORT=5432

# Redis 7
REDIS_PASSWORD=aegis_redis_change_me
REDIS_PORT=6379

# RabbitMQ 3.13
RABBITMQ_USER=aegis
RABBITMQ_PASSWORD=aegis_mq_change_me
RABBITMQ_VHOST=/
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# MinIO (S3 兼容证据对象存储)
MINIO_ROOT_USER=aegis
MINIO_ROOT_PASSWORD=aegis_minio_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=aegis-evidence
S3_IMAGES_RETENTION_DAYS=90
S3_VIDEOS_RETENTION_DAYS=30

# MediaMTX
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_WHEP_PORT=8889
MEDIAMTX_WEBRTC_MUX_PORT=8189
MEDIAMTX_API_PORT=9997
# 填宿主机/平台服务器内网固定 IP，确保跨网段浏览器 WebRTC 正常建连
MEDIAMTX_WEBRTC_ADDITIONAL_HOST=127.0.0.1
# 纯基础设施联调阶段可为 internal；完整平台上线时改为 http
MEDIAMTX_AUTH_METHOD=http
MEDIAMTX_AUTH_HTTP_ADDRESS=http://aegis-api:8081/internal/mediamtx/auth

# 平台入口与安全密钥（部署前务必替换所有默认密钥！）
NGINX_HTTP_PORT=80
INGEST_GRPC_PORT=9090
AEGIS_PUBLIC_BASE_URL=http://127.0.0.1
AEGIS_JWT_SECRET=aegis-prod-jwt-secret-replace-with-32plus-chars
AEGIS_EVIDENCE_SIGN_SECRET=aegis-prod-sign-secret-replace-with-32plus-chars
AEGIS_AGENT_TOKEN=aegis-agent-cluster-token-replace-me
AEGIS_INIT_ADMIN_PASSWORD=Admin@123456
